 ('f2210000-0000-4000-8000-000000000001','cod-actor@example.invalid'),
 ('f2210000-0000-4000-8000-000000000002','cod-other@example.invalid');
INSERT INTO public.branches(id,code,slug,name,active,delivery_enabled) VALUES
