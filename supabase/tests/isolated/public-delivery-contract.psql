INSERT INTO public.profiles(id,name,role,active,home_branch_id) VALUES
 ('f2210000-0000-4000-8000-000000000001','Fixture A','ATTENDANT',true,'f2210000-0000-4000-8000-000000000011'),
 ('f2210000-0000-4000-8000-000000000002','Fixture B','ATTENDANT',true,'f2210000-0000-4000-8000-000000000012');
INSERT INTO public.profile_branches(profile_id,branch_id) VALUES
